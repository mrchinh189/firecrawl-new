# --- Firecrawl ---
# URL của Firecrawl self-host (docker compose ở thư mục gốc repo chạy cổng 3002)
FIRECRAWL_API_URL=http://localhost:3002
# Self-host với USE_DB_AUTHENTICATION=false thì để trống
FIRECRAWL_API_KEY=
# (Tuỳ chọn) key Firecrawl Cloud, chỉ dùng khi self-host cào lỗi (vd. trang chặn bot)
FIRECRAWL_FALLBACK_API_KEY=

# --- Google Sheets --- (để trống GOOGLE_SHEET_ID => ghi CSV vào ./data)
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./service_account.json

# --- Cảnh báo Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Cảnh báo Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
