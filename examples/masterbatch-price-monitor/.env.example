# ============ Firecrawl ============
# Self-host (local docker): http://localhost:3002  — KHÔNG cần API key
# Cloud (api.firecrawl.dev): để FIRECRAWL_API_URL trống, điền FIRECRAWL_API_KEY
FIRECRAWL_API_URL=http://localhost:3002
FIRECRAWL_API_KEY=

# ============ AI cho /extract ============
# Cần để Firecrawl bóc giá thành JSON có cấu trúc (nếu self-host).
# Set trong .env của Firecrawl (thư mục gốc repo), KHÔNG phải ở đây.
# Ở đây chỉ để tham khảo.

# ============ PostgreSQL (lưu lịch sử giá) ============
# Dùng luôn Postgres trong docker-compose của Firecrawl, hoặc DB riêng.
PGHOST=localhost
PGPORT=5432
PGDATABASE=firecrawl
PGUSER=firecrawl
PGPASSWORD=firecrawl_password

# ============ Cảnh báo: ngưỡng biến động giá (%) ============
# Bắn cảnh báo khi giá thay đổi vượt ngưỡng này so với lần ghi nhận trước.
ALERT_THRESHOLD_PERCENT=5

# ============ Telegram (tùy chọn) ============
# Tạo bot qua @BotFather để lấy token, lấy chat_id qua @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============ Email (tùy chọn, SMTP) ============
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
